{
	"name": "@vertracloud/blob",
	"version": "0.0.0",
	"private": false,
	"description": "Official JavaScript/TypeScript SDK for Vertra Cloud Blob Storage. Works in Node.js 18+, browsers and edge runtimes.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://vertracloud.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vertracloud/sdk-blob-js.git"
	},
	"bugs": {
		"url": "https://github.com/vertracloud/sdk-blob-js/issues"
	},
	"keywords": [
		"vertracloud",
		"vertra cloud",
		"sdk",
		"blob",
		"storage",
		"object-storage",
		"upload"
	],
	"author": "Eydrenn Araujo",
	"engines": {
		"node": ">=18.17"
	},
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --fix .",
		"check": "npm run typecheck && npm run lint && npm run test"
	},
	"dependencies": {
		"@vertracloud/api-types": "file:../api-types"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
